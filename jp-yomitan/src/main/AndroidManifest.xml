<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AnkiDroid's API (roadmap 3.2): a runtime permission the user grants from the popup or settings. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <queries>
        <!-- AnkiDroid's content provider and its card browser and sync intents. -->
        <package android:name="com.ichi2.anki" />
        <!-- Text-to-speech engines, for the TTS audio source (3.3). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <!--
          The lookup screens (roadmap 3.4). Their classes are the app's (jp.reikai.lookup), which reach
          the app's graph; declared here so upstream's manifest stays untouched.
        -->
        <!-- "Look up in Reikai JP" in every app's text-selection menu; switched off with lookup (D-025). -->
        <activity
            android:name="jp.reikai.lookup.LookupActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/jp_lookup_in_app"
            android:taskAffinity=""
            android:theme="@style/Theme.JpLookup">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The dictionary search screen (the launcher's "Dictionary" shortcut). -->
        <activity
            android:name="jp.reikai.lookup.DictionaryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="@string/jp_dictionary_long"
            android:launchMode="singleTop"
            android:theme="@style/Theme.JpDictionary"
            android:windowSoftInputMode="adjustResize" />
        <!-- Yomitan's own settings and other pages (roadmap 3.5), opened from the Japanese settings. -->
        <activity
            android:name="jp.reikai.settings.YomitanSettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="@string/jp_yomitan_settings"
            android:theme="@style/Theme.JpDictionary"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name="jp.reikai.yomitan.anki.AnkiMediaProvider"
            android:authorities="${applicationId}.jp-anki-media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/jp_anki_media_paths" />
        </provider>
    </application>

</manifest>
