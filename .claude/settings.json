{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5-5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "additionalDirectories": [
      "~/myApplications/refs"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git ls-files*)",
      "Bash(git grep*)",
      "Bash(git merge-base*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin*)",
      "Bash(scripts/fork/*)",
      "Bash(python3 scripts/fork/*)",
      "Bash(python3 .claude/hooks/test_hooks.py)",
      "Bash(./gradlew*)",
      "Bash(adb devices*)",
      "Bash(adb logcat*)",
      "Bash(adb exec-out screencap*)",
      "Bash(adb shell uiautomator dump*)",
      "Bash(adb shell am *)",
      "Bash(adb shell monkey*)",
      "Bash(adb pull*)",
      "Bash(adb install*)",
      "Bash(adb pair*)",
      "Bash(adb connect*)",
      "Bash(adb forward*)",
      "Read(~/myApplications/refs/**)",
      "Grep(~/myApplications/refs/**)",
      "Glob(~/myApplications/refs/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/keystore.properties)",
      "Read(**/google-services.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/keystore.properties)",
      "Edit(**/google-services.json)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.jks)",
      "Write(**/*.keystore)",
      "Write(**/keystore.properties)",
      "Write(**/google-services.json)",
      "Bash(git push upstream*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_edit.py"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
